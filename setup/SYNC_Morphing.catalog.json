                 ],
        "dependencies":  [

                         ],
        "images":  [

                   ],
        "installer":  {
                          "source":  {
                                         "direct":  null,
                                         "github":  {
                                                        "owner":  "vramwiz",
                                                        "repo":  "SYNC_Morphing",
                                                        "pattern":  "^SYNC_Morphing\\.zip$"
                                                    }
                                     },
                          "install":  [
                                          {
                                              "action":  "download"
                                          },
                                          {
